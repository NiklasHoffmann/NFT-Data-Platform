NODE_ENV=development
APP_BASE_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nft_data_platform
REDIS_URL=redis://localhost:6379
CORS_ALLOWED_ORIGINS=
API_MAX_REQUEST_BYTES=1048576
PUBLIC_READ_RATE_LIMIT_PER_MINUTE=180
API_CLIENT_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nft-media
S3_PUBLIC_BASE_URL=http://localhost:9000/nft-media
MEDIA_MAX_VIDEO_BYTES=25000000
CHAIN_INDEXING_ENABLED=false
CHAIN_INDEXING_POLL_INTERVAL_MS=30000
CHAIN_INDEXING_BATCH_SIZE=10
CHAIN_INDEXING_MAX_BLOCK_RANGE=2000
CHAIN_INDEXING_COLLECTION_ALLOWLIST=
# RPC URLs — new format: one variable per chain ID (e.g. RPC_URL_1 for Ethereum Mainnet)
# The legacy names RPC_MAINNET_URL and RPC_SEPOLIA_URL are still accepted as fallbacks.
RPC_URL_1=https://mainnet.example-rpc.invalid
RPC_URL_10=https://optimism.example-rpc.invalid
RPC_URL_137=https://polygon.example-rpc.invalid
RPC_URL_8453=https://base.example-rpc.invalid
RPC_URL_42161=https://arbitrum.example-rpc.invalid
RPC_URL_7777777=https://zora.example-rpc.invalid
RPC_URL_11155111=https://sepolia.example-rpc.invalid
RPC_URL_84532=https://base-sepolia.example-rpc.invalid
RPC_URL_80002=https://polygon-amoy.example-rpc.invalid
# Legacy fallback names (still supported, but prefer RPC_URL_<chainId> above)
# RPC_MAINNET_URL=https://mainnet.example-rpc.invalid
# RPC_SEPOLIA_URL=https://sepolia.example-rpc.invalid
API_BOOTSTRAP_CLIENT_ID=local-operator
API_BOOTSTRAP_KEY=nft_local_bootstrap_key
API_BOOTSTRAP_SECRET=nft_local_bootstrap_secret
API_BOOTSTRAP_SCOPES=collections:read,tokens:read,owners:read,search:read,refresh:token,refresh:collection,refresh:media,reindex:write,admin:read
API_BOOTSTRAP_RATE_LIMIT_PER_MINUTE=300
API_BOOTSTRAP_ALLOWED_IPS=
AUTH_MAX_TIMESTAMP_SKEW_SEC=300

# Data freshness: how long materialized metadata stays valid before it is refreshed.
TOKEN_METADATA_TTL_SECONDS=86400
TOKEN_METADATA_FAILURE_RETRY_SECONDS=21600
COLLECTION_METADATA_TTL_SECONDS=604800
# Read path: serve the stored token immediately and queue a refresh behind the response.
READ_REVALIDATION_ENABLED=true
READ_REVALIDATION_DEBOUNCE_SECONDS=300
# Worker sweep: periodically re-queue whatever has aged out of its TTL.
METADATA_SWEEP_ENABLED=false
METADATA_SWEEP_INTERVAL_MS=60000
METADATA_SWEEP_BATCH_SIZE=25
